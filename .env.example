DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
PERSONAL_MYTH_MODEL=deepseek-v4-pro
MEETING_MODEL=deepseek-v4-pro
ALBERT_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_MS=60000
NODE_ENV=development
PORT=3000
# Current candidate: Myth / Meeting / Albert use RouterAI only.
# Load the real key through the existing secret/environment mechanism; never commit it.
ROUTERAI_API_KEY=
# Model IDs, upstream policy and bounded fallback are fixed in server/routerai.ts.


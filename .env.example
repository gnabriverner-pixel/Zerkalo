# --- Лаборатория «Зеркало себя» (Gate 1: Личный миф) ---

# DeepSeek V4 — актуальные model IDs.
# deepseek-chat / deepseek-reasoner устарели (отключены 24.07.2026) — не использовать.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Личный миф (независимая линза, только 4 ответа человека)
PERSONAL_MYTH_ENABLED=1
PERSONAL_MYTH_MODEL=deepseek-v4-flash
PERSONAL_MYTH_TIMEOUT_MS=45000

# Blind A/B: одинаковые настройки для обеих моделей
LAB_MYTH_MODEL_A=deepseek-v4-flash
LAB_MYTH_MODEL_B=deepseek-v4-pro
LAB_MYTH_TEMPERATURE=0.72
# thinking: off | high | max — одинаково для A и B; off по умолчанию.
# ВАЖНО (DeepSeek V4): режим задаётся явно через thinking.type=disabled/enabled —
# по умолчанию API включает thinking, и content может быть пустым.
LAB_MYTH_THINKING=off
LAB_MYTH_REASONING_EFFORT=high

# Замороженный Gemini-контур снапшота (lab-флоу его не использует)
GEMINI_API_KEY=

NODE_ENV=development
PORT=3000

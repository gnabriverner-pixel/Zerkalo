{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/g1c-phase1-blind-v2-result.schema.json",
  "title": "G1C Phase-1 Blind V2 Result",
  "type": "array",
  "minItems": 30,
  "maxItems": 30,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "required": [
      "target_id",
      "scores",
      "confidence",
      "evidence",
      "identity",
      "genericness",
      "counterfactual"
    ],
    "properties": {
      "target_id": {
        "$ref": "#/$defs/target_id"
      },
      "scores": {
        "$ref": "#/$defs/dimensions"
      },
      "confidence": {
        "type": "object",
        "required": ["overall", "per_dimension"],
        "properties": {
          "overall": {
            "$ref": "#/$defs/rating"
          },
          "per_dimension": {
            "$ref": "#/$defs/dimensions"
          }
        },
        "additionalProperties": false
      },
      "evidence": {
        "type": "object",
        "required": [
          "grounding",
          "specificity",
          "literary_quality",
          "non_genericity",
          "insight_delta",
          "restraint"
        ],
        "properties": {
          "grounding": {"$ref": "#/$defs/evidence_item"},
          "specificity": {"$ref": "#/$defs/evidence_item"},
          "literary_quality": {"$ref": "#/$defs/evidence_item"},
          "non_genericity": {"$ref": "#/$defs/evidence_item"},
          "insight_delta": {"$ref": "#/$defs/evidence_item"},
          "restraint": {"$ref": "#/$defs/evidence_item"}
        },
        "additionalProperties": false
      },
      "identity": {
        "type": "object",
        "required": ["choice", "confidence", "evidence"],
        "properties": {
          "choice": {
            "type": "string",
            "enum": ["A", "B", "C", "D", "E"]
          },
          "confidence": {
            "$ref": "#/$defs/rating"
          },
          "evidence": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      },
      "genericness": {
        "type": "object",
        "required": ["label", "score", "evidence"],
        "properties": {
          "label": {
            "type": "string",
            "enum": ["only_source", "few_candidates", "most_candidates"]
          },
          "score": {
            "$ref": "#/$defs/rating"
          },
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      },
      "counterfactual": {
        "type": "object",
        "required": ["grounded", "evidence"],
        "properties": {
          "grounded": {"type": "boolean"},
          "evidence": {
            "type": "array",
            "items": {"$ref": "#/$defs/counterfactual_evidence"}
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"grounded": {"const": false}},
              "required": ["grounded"]
            },
            "then": {
              "properties": {"evidence": {"type": "array", "minItems": 2}}
            }
          },
          {
            "if": {
              "properties": {"grounded": {"const": true}},
              "required": ["grounded"]
            },
            "then": {
              "properties": {"evidence": {"type": "array", "minItems": 1}}
            }
          }
        ],
        "additionalProperties": false
      },
      "notes": {"type": "string"}
    },
    "additionalProperties": false
  },
  "$defs": {
    "target_id": {
      "type": "string",
      "pattern": "^T(?:00[1-9]|0[12][0-9]|030)$"
    },
    "rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "dimensions": {
      "type": "object",
      "required": [
        "grounding",
        "specificity",
        "literary_quality",
        "non_genericity",
        "insight_delta",
        "restraint"
      ],
      "properties": {
        "grounding": {"$ref": "#/$defs/rating"},
        "specificity": {"$ref": "#/$defs/rating"},
        "literary_quality": {"$ref": "#/$defs/rating"},
        "non_genericity": {"$ref": "#/$defs/rating"},
        "insight_delta": {"$ref": "#/$defs/rating"},
        "restraint": {"$ref": "#/$defs/rating"}
      },
      "additionalProperties": false
    },
    "evidence_item": {
      "type": "object",
      "required": ["quote", "reference"],
      "properties": {
        "quote": {"type": "string", "minLength": 1, "maxLength": 200},
        "reference": {
          "type": "string",
          "enum": [
            "q1",
            "q2",
            "q3",
            "q4",
            "title",
            "story",
            "mirror.mainImage",
            "mirror.innerTension",
            "mirror.hiddenResource",
            "mirror.newView",
            "meaning[0]",
            "meaning[1]",
            "meaning[2]",
            "one_step",
            "journal_question",
            "disclaimer"
          ]
        }
      },
      "additionalProperties": false
    },
    "counterfactual_evidence": {
      "type": "object",
      "required": ["myth_quote", "answer_ref", "reason"],
      "properties": {
        "myth_quote": {"type": "string", "minLength": 1},
        "answer_ref": {"type": "string", "enum": ["q1", "q2", "q3", "q4"]},
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
